{
  "name": "winden-tokens",
  "version": "0.1.0",
  "description": "Run the Winden Tokens Figma plugin UI full-size in a browser, driving the Figma file you have open. Local relay + prebuilt UI, loopback only.",
  "type": "module",
  "bin": {
    "winden-tokens": "cli.mjs"
  },
  "main": "server.mjs",
  "exports": {
    ".": "./server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "cli.mjs",
    "server.mjs",
    "ui/index.html"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepack": "node ./scripts/build-ui.mjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "design-tokens",
    "winden",
    "bridge"
  ],
  "author": "Marko Krstic",
  "license": "MIT",
  "homepage": "https://github.com/krstivoja/winden-tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krstivoja/winden-tokens.git",
    "directory": "bridge"
  },
  "bugs": {
    "url": "https://github.com/krstivoja/winden-tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
